POSTGRES_DB=pathgraph
POSTGRES_USER=pathgraph
POSTGRES_PASSWORD=pathgraph
DATABASE_URL=postgresql+psycopg://pathgraph:pathgraph@postgres:5432/pathgraph
JWT_SECRET=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local backend only: absolute path to a Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Container alternative: one-line JSON supplied through a secret environment variable.
FIREBASE_CREDENTIALS_JSON=
LOCAL_AUTH_ENABLED=false
DEMO_GRAPH_ENABLED=false
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOURCE_STORAGE_DIR=/data/sources
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_LOCAL_AUTH_ENABLED=false
